{
  "name": "@n-sfu/json-rpc",
  "version": "1.0.0",
  "type": "module",
  "description": "JSON RPC 2.0 implementation for Node.js and browser",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run ./tests",
    "test:watch": "vitest ./tests",
    "type": "tsc --noEmit",
    "lint": "biome check --write src tests"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}